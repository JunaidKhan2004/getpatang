{
  "version": "2.0.0",
  "tasks": [
    {
      // Makes 127.0.0.1:4000 on every connected Android phone/emulator reach the API on this computer (over USB).
      "label": "Connect Android devices to local API",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/mobile/tool/connect-devices.ps1"
      ],
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
