# Production settings for docker-compose.yml. Copy to .env.production on the server and fill in.
# Never commit .env.production. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Domains (point both DNS A records at the server first)
WEB_DOMAIN=kiteplatform.pk
API_DOMAIN=api.kiteplatform.pk
# Receives certificate expiry notices
ACME_EMAIL=ops@kiteplatform.pk

# Database
POSTGRES_DB=kite_platform
POSTGRES_USER=kite
POSTGRES_PASSWORD=

# Secrets (48+ random characters each)
JWT_ACCESS_SECRET=
OTP_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Email (required in production: sign-in codes and notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kite Platform <no-reply@kiteplatform.pk>"

# First Super Admin, created by: docker compose --env-file .env.production run --rm api seed
# Remove these two lines after the first deploy and change the password after signing in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
