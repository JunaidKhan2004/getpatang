# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Comma-separated list of web origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# SQLite for development. PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/kite_platform
DATABASE_URL=file:./dev.db

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_SECRET=change-me-otp-secret-at-least-32-chars

# How one-time codes are delivered: console (development only) | email | sms
# "console" prints codes to the server log and is refused when NODE_ENV=production.
OTP_CHANNEL=console

# Email (notifications and, with OTP_CHANNEL=email, sign-in codes)
# console = log emails instead of sending them (development only); smtp = send through SMTP_HOST
MAIL_TRANSPORT=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="GetPatang <no-reply@example.com>"
# Web address used for links inside emails
WEB_ORIGIN=http://localhost:3000

# Local file storage for uploads (development). Production uses object storage.
UPLOAD_DIR=uploads
# Origin used to build public file URLs (images)
PUBLIC_API_ORIGIN=http://localhost:4000

# First Super Admin, created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@kiteplatform.local
SEED_ADMIN_PASSWORD=ChangeMe123
