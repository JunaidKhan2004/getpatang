// Kite Platform — database schema.
// Phase 1 (Foundation): identity, access control, audit and settings.
// Later phases add marketplace, tournaments, community, etc. as separate model groups.
//
// Development and tests use SQLite (migrations in prisma/migrations). Production uses PostgreSQL:
// after changing models here, run `npm run db:pg -- <name>` to update prisma/postgres/ and its migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

model User {
  id              String     @id @default(cuid())
  fullName        String
  email           String     @unique
  phone           String?    @unique
  passwordHash    String
  isVerified      Boolean    @default(false)
  emailVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  profile       Profile?
  roles         UserRole[]     @relation("UserRoles")
  rolesAssigned UserRole[]     @relation("RoleAssigner")
  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  auditLogs     AuditLog[]

  shop          Shop?          @relation("ShopOwner")
  followedShops ShopFollower[]
  reviews       Review[]
  wishlist      WishlistItem[]
  cartItems     CartItem[]
  addresses     Address[]
  orders        Order[]
  uploads       Upload[]

  tournamentsCreated Tournament[]            @relation("TournamentCreator")
  tournamentEntries  TournamentParticipant[]
  officiatedMatches  Match[]                 @relation("MatchOfficial")
  submittedResults   MatchResult[]           @relation("ResultSubmitter")
  rankingPoints      RankingPoint[]

  posts           Post[]       @relation("PostAuthor")
  comments        Comment[]    @relation("CommentAuthor")
  postLikes       PostLike[]
  following       UserFollow[] @relation("Following")
  followers       UserFollow[] @relation("Followers")
  blocking        UserBlock[]  @relation("Blocking")
  blockedBy       UserBlock[]  @relation("BlockedBy")
  reportsFiled    Report[]     @relation("ReportsFiled")
  reportsResolved Report[]     @relation("ReportsResolved")

  eventsCreated       Event[]              @relation("EventCreator")
  eventRegistrations  EventRegistration[]
  customDesigns       CustomDesign[]
  customOrders        CustomOrderRequest[] @relation("CustomOrderCustomer")
  customOrderMessages CustomOrderMessage[] @relation("CustomOrderAuthor")

  notifications        Notification[]
  notificationSettings NotificationSetting?
  devices              DeviceToken[]
  paymentsReviewed     Payment[]            @relation("PaymentReviewer")
  refundsProcessed     Refund[]             @relation("RefundProcessor")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  displayName String
  city        String?
  bio         String?
  avatarUrl   String? // object-storage URL, never file bytes
  dateOfBirth DateTime? // needed for tournament age eligibility
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city])
  @@map("profiles")
}

// ─── Access control (configurable at runtime, seeded with defaults) ─────────

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. SUPER_ADMIN, SELLER — see src/common/auth/roles.ts
  name        String
  description String?
  isSystem    Boolean  @default(true) // system roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. users.manage — see src/common/auth/permissions.ts
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── Sessions & one-time codes ───────────────────────────────────────────────

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique // SHA-256 of the opaque token; the raw token is never stored
  familyId     String // all rotations of one login share a family; reuse revokes the family
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum OtpPurpose {
  VERIFY_ACCOUNT
  RESET_PASSWORD
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String // HMAC-SHA256 of the code
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("otp_codes")
}

// ─── Audit & settings ────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. auth.login, user.suspend
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Setting {
  key         String   @id // e.g. payments.methods, rankings.formula
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("settings")
}

// ─── Marketplace (Phase 2) ───────────────────────────────────────────────────
// Money is stored as whole Pakistani rupees (Int). Order lines snapshot product data
// so later product edits never change past orders.

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

enum ShopStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model Shop {
  id            String     @id @default(cuid())
  ownerId       String     @unique
  name          String
  slug          String     @unique
  description   String?
  logoUrl       String?
  bannerUrl     String?
  city          String
  address       String?
  phone         String?
  email         String?
  status        ShopStatus @default(PENDING)
  isVerified    Boolean    @default(false)
  ratingAvg     Float      @default(0)
  ratingCount   Int        @default(0)
  followerCount Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Seller application (Phase 3). Visible only to the owner and staff with sellers.review.
  cnicNumber          String?
  payoutMethod        String? // bank | jazzcash | easypaisa
  payoutAccountTitle  String?
  payoutAccountNumber String? // IBAN or mobile wallet number
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewedById        String?
  reviewNote          String? // reason shown to the seller when rejected or suspended
  acceptsCustomOrders Boolean   @default(true)

  owner        User                 @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  products     Product[]
  followers    ShopFollower[]
  orders       Order[]
  documents    ShopDocument[]
  customOrders CustomOrderRequest[]

  @@index([status, city])
  @@index([status, submittedAt])
  @@map("shops")
}

model ShopDocument {
  id        String   @id @default(cuid())
  shopId    String
  type      String // cnic_front | cnic_back | business_registration | other
  uploadId  String   @unique
  createdAt DateTime @default(now())

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("shop_documents")
}

// Files in object storage. Rows let the API check that a referenced file belongs to the caller.
model Upload {
  id           String   @id @default(cuid())
  ownerId      String
  purpose      String // product_image | shop_logo | shop_banner | seller_document | avatar
  storageKey   String   @unique
  url          String? // public URL; null for private files
  mimeType     String
  size         Int
  originalName String
  isPrivate    Boolean  @default(false)
  createdAt    DateTime @default(now())

  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  document  ShopDocument?
  postMedia PostMedia?

  @@index([ownerId, purpose])
  @@map("uploads")
}

model ShopFollower {
  userId    String
  shopId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([userId, shopId])
  @@index([shopId])
  @@map("shop_followers")
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  HIDDEN
  REMOVED
}

model Product {
  id             String        @id @default(cuid())
  shopId         String
  categoryId     String
  title          String
  slug           String        @unique
  description    String
  specifications Json? // [{ label, value }]
  shippingInfo   String?
  videoUrl       String?
  price          Int
  compareAtPrice Int? // original price when discounted
  stock          Int           @default(0) // used when the product has no variants
  sku            String?
  status         ProductStatus @default(DRAFT)
  ratingAvg      Float         @default(0)
  ratingCount    Int           @default(0)
  salesCount     Int           @default(0)
  isFeatured     Boolean       @default(false) // shown first on the shop page
  lowStockAt     Int           @default(5) // seller is warned at or below this stock
  reviewNote     String? // moderator's reason when rejected
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  shop         Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images       ProductImage[]
  variants     ProductVariant[]
  reviews      Review[]
  wishlistedBy WishlistItem[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([status, categoryId])
  @@index([shopId, status])
  @@index([status, createdAt])
  @@index([status, price])
  @@index([status, salesCount])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String // object-storage URL
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String // e.g. "Large · Red"
  sku       String?
  price     Int? // overrides the product price when set
  stock     Int     @default(0)
  isActive  Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  orderItemId String?  @unique
  rating      Int // 1–5
  comment     String?
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@map("reviews")
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("wishlist_items")
}

model CartItem {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  variantId     String?
  quantity      Int
  savedForLater Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cart_items")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String? // Home, Work…
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  province   String?
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Int // percent (1–100) or rupees
  minSubtotal Int        @default(0)
  maxDiscount Int? // cap for percent coupons
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  @@map("coupons")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

enum PaymentStatus {
  PENDING
  VERIFYING // the customer sent transfer details; staff are checking
  PAID
  FAILED
  REFUNDED
}

// One order per shop. Orders placed together share a checkoutId.
model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  checkoutId      String
  userId          String
  shopId          String
  status          OrderStatus   @default(PENDING)
  subtotal        Int
  shippingFee     Int
  discount        Int           @default(0)
  total           Int
  couponCode      String?
  deliveryMethod  String
  paymentMethod   String
  paymentStatus   PaymentStatus @default(PENDING)
  shippingAddress Json // snapshot of the address at checkout
  contactPhone    String
  notes           String?
  courierName     String?
  trackingNumber  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  shop          Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  events        OrderStatusEvent[]
  refunds       Refund[]
  payments      Payment[]
  customRequest CustomOrderRequest?

  @@index([userId, createdAt])
  @@index([shopId, status])
  @@index([checkoutId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  title       String
  variantName String?
  imageUrl    String?
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  review  Review?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  provider      String // cod, bank_transfer … (see src/modules/payments/payment-providers.ts)
  amount        Int
  status        PaymentStatus @default(PENDING)
  reference     String? // the customer's transfer reference / transaction id
  metadata      Json?
  // Bank transfer proof (Phase 7). The receipt file is private.
  proofUploadId String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNote    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  refunds    Refund[]

  @@index([orderId])
  @@index([status, provider])
  @@map("payments")
}

// ─── Tournaments (Phase 4) ───────────────────────────────────────────────────
// Only legally permitted events: publishing requires a permit reference and safety rules.

enum TournamentStatus {
  DRAFT
  PUBLISHED // visible; registration follows the registration window
  IN_PROGRESS // bracket generated, matches being played
  COMPLETED
  CANCELLED
}

model Tournament {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  name                 String
  description          String
  city                 String
  venue                String
  venueAddress         String?
  startsAt             DateTime
  endsAt               DateTime?
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  status               TournamentStatus @default(DRAFT)
  format               String           @default("single_elimination")
  maxParticipants      Int
  minAge               Int              @default(16)
  entryFee             Int              @default(0) // rupees; collected by the organizer until online payments exist
  prizeInfo            String?
  rules                String
  safetyRules          String
  approvedMaterials    String // e.g. "Paper kites, plain cotton string only"
  venueRestrictions    String?
  permitReference      String? // local authority permission; required to publish
  organizerName        String
  organizerContact     String?
  season               String // e.g. "2027"; used by rankings
  bannerUrl            String?
  cancelReason         String?
  createdById          String
  publishedAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  createdBy     User                    @relation("TournamentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants  TournamentParticipant[]
  matches       Match[]
  rankingPoints RankingPoint[]

  @@index([status, startsAt])
  @@index([city, startsAt])
  @@index([season])
  @@map("tournaments")
}

enum ParticipantStatus {
  PENDING // waiting for the organizer (e.g. entry fee not yet received)
  CONFIRMED
  WAITLISTED
  WITHDRAWN
  REJECTED
  DISQUALIFIED
}

model TournamentParticipant {
  id              String            @id @default(cuid())
  tournamentId    String
  userId          String
  status          ParticipantStatus @default(PENDING)
  seed            Int?
  acceptedRulesAt DateTime
  statusNote      String?
  finalPlacement  Int? // 1 = champion, 2 = runner-up, 3 = semi-finalist, …
  registeredAt    DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  matchesA   Match[]    @relation("PlayerA")
  matchesB   Match[]    @relation("PlayerB")
  matchesWon Match[]    @relation("MatchWinner")

  @@unique([tournamentId, userId])
  @@index([tournamentId, status])
  @@index([userId])
  @@map("tournament_participants")
}

enum MatchStatus {
  SCHEDULED
  CHECK_IN
  LIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

model Match {
  id            String      @id @default(cuid())
  tournamentId  String
  round         Int // 1 = first round
  matchNumber   Int // unique within the tournament, in play order
  position      Int // position within the round (0-based), drives bracket layout
  playerAId     String?
  playerBId     String?
  winnerId      String?
  scoreA        Int?
  scoreB        Int?
  isBye         Boolean     @default(false)
  isWalkover    Boolean     @default(false)
  status        MatchStatus @default(SCHEDULED)
  scheduledAt   DateTime?
  location      String? // area or pitch within the venue
  officialId    String?
  nextMatchId   String?
  nextSlot      String? // "A" or "B"
  resultNote    String?
  disputeReason String?
  disputedById  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tournament Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerA    TournamentParticipant? @relation("PlayerA", fields: [playerAId], references: [id], onDelete: SetNull)
  playerB    TournamentParticipant? @relation("PlayerB", fields: [playerBId], references: [id], onDelete: SetNull)
  winner     TournamentParticipant? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  official   User?                  @relation("MatchOfficial", fields: [officialId], references: [id], onDelete: SetNull)
  results    MatchResult[]

  @@unique([tournamentId, matchNumber])
  @@index([tournamentId, round, position])
  @@index([officialId, status])
  @@index([status, scheduledAt])
  @@map("matches")
}

// Every result submission or correction, kept for the audit trail.
model MatchResult {
  id               String   @id @default(cuid())
  matchId          String
  submittedById    String
  winnerId         String
  scoreA           Int?
  scoreB           Int?
  isWalkover       Boolean  @default(false)
  note             String?
  evidenceUploadId String?
  kind             String   @default("result") // result | dispute_upheld | dispute_overturned
  createdAt        DateTime @default(now())

  match       Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submittedBy User  @relation("ResultSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)

  @@index([matchId, createdAt])
  @@map("match_results")
}

// Ranking history: points a player earned in one completed tournament. Rankings sum these.
model RankingPoint {
  id           String   @id @default(cuid())
  userId       String
  tournamentId String
  season       String
  city         String
  placement    Int
  wins         Int
  losses       Int
  points       Int
  awardedAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
  @@index([season, city])
  @@index([tournamentId])
  @@map("ranking_points")
}

// ─── Community (Phase 5) ─────────────────────────────────────────────────────

enum ContentStatus {
  VISIBLE
  HIDDEN // hidden by a moderator or by automatic report threshold, pending review
  REMOVED // deleted by its author or removed by a moderator
}

model Post {
  id             String        @id @default(cuid())
  authorId       String
  body           String
  status         ContentStatus @default(VISIBLE)
  likeCount      Int           @default(0)
  commentCount   Int           @default(0)
  shareCount     Int           @default(0)
  moderationNote String?
  editedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  author   User        @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  media    PostMedia[]
  likes    PostLike[]
  comments Comment[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@map("posts")
}

model PostMedia {
  id        String @id @default(cuid())
  postId    String
  uploadId  String @unique
  kind      String // image | video
  url       String
  mimeType  String
  sortOrder Int    @default(0)

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("post_media")
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  parentId  String? // one level of replies
  body      String
  status    ContentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@map("comments")
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("user_follows")
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

// Reports about any kind of content. Community handles posts, comments and users;
// the full reports & disputes workflow for products, shops, orders and matches follows in Phase 11.
model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetType   String // post | comment | user | product | shop | match | order
  targetId     String
  reason       String // spam | harassment | dangerous | inappropriate | misinformation | other
  details      String?
  status       ReportStatus @default(OPEN)
  action       String? // what the moderator did: dismissed | hidden | removed | restored
  resolution   String? // note from the moderator
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  reporter   User  @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("reports")
}

// ─── Events (Phase 6) ────────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model Event {
  id                   String      @id @default(cuid())
  slug                 String      @unique
  name                 String
  type                 String // festival | exhibition | workshop | gathering | competition
  description          String
  city                 String
  venue                String
  venueAddress         String?
  startsAt             DateTime
  endsAt               DateTime?
  organizerName        String
  organizerContact     String?
  rules                String?
  safetyNotes          String
  capacity             Int? // people including guests; null = no limit
  registrationRequired Boolean     @default(true)
  registrationClosesAt DateTime?
  fee                  Int         @default(0) // rupees, paid to the organizer
  maxGuests            Int         @default(2) // extra people one registration may bring
  bannerUrl            String?
  tournamentId         String? // optional link when the event hosts a tournament
  status               EventStatus @default(DRAFT)
  cancelReason         String?
  createdById          String
  publishedAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  createdBy     User                @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  registrations EventRegistration[]

  @@index([status, startsAt])
  @@index([city, startsAt])
  @@map("events")
}

enum EventRegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

model EventRegistration {
  id        String                  @id @default(cuid())
  eventId   String
  userId    String
  status    EventRegistrationStatus @default(CONFIRMED)
  guests    Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@map("event_registrations")
}

// ─── Custom kite designs & custom orders (Phase 6) ──────────────────────────

model CustomDesign {
  id        String   @id @default(cuid())
  userId    String
  name      String
  design    Json // shape, colours, pattern, text, image — rendered the same way on web and mobile
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests CustomOrderRequest[]

  @@index([userId, updatedAt])
  @@map("custom_designs")
}

enum CustomOrderStatus {
  REQUESTED // waiting for the shop
  CLARIFICATION_NEEDED // the shop asked a question
  QUOTED // the shop sent a price
  ACCEPTED // the customer accepted; a real order was created
  DECLINED // the customer declined the quote
  REJECTED // the shop cannot make it
  CANCELLED // the customer withdrew before accepting
}

model CustomOrderRequest {
  id                String            @id @default(cuid())
  number            String            @unique
  userId            String
  shopId            String
  designId          String?
  designSnapshot    Json // the design as it was when requested
  designName        String
  quantity          Int
  requirements      String
  budget            Int?
  deadline          DateTime?
  status            CustomOrderStatus @default(REQUESTED)
  quotePrice        Int? // total for all pieces, rupees
  quoteDeliveryDays Int?
  quoteNote         String?
  quoteValidUntil   DateTime?
  quotedAt          DateTime?
  orderId           String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user     User                 @relation("CustomOrderCustomer", fields: [userId], references: [id], onDelete: Restrict)
  shop     Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  design   CustomDesign?        @relation(fields: [designId], references: [id], onDelete: SetNull)
  order    Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages CustomOrderMessage[]

  @@index([userId, createdAt])
  @@index([shopId, status])
  @@map("custom_order_requests")
}

model CustomOrderMessage {
  id        String   @id @default(cuid())
  requestId String
  authorId  String?
  role      String // customer | seller | system
  body      String
  createdAt DateTime @default(now())

  request CustomOrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User?              @relation("CustomOrderAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("custom_order_messages")
}

// ─── Refunds & notifications (Phase 7) ──────────────────────────────────────

enum RefundStatus {
  PENDING // money is owed back to the customer
  COMPLETED // staff sent it and recorded the reference
}

model Refund {
  id            String       @id @default(cuid())
  orderId       String
  paymentId     String?
  amount        Int
  reason        String
  status        RefundStatus @default(PENDING)
  reference     String? // bank / wallet transaction id of the refund
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  processedBy User?    @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("refunds")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  category  String // orders | payments | shop | tournaments | events | community | custom_orders | account
  type      String // e.g. order.status, payment.verified
  title     String
  body      String
  link      String? // web path, e.g. /account/orders/KP-…; the app maps it to a screen
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Per-category channel choices. Missing categories use the defaults in notifications.ts.
model NotificationSetting {
  userId    String   @id
  prefs     Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String // android | ios | web
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ─── Content pages (Phase 8) ────────────────────────────────────────────────

/// Editable public pages (about, contact, faq, terms, privacy). Text is plain, with blank lines
/// between paragraphs and "## " for headings; rendered the same on web and mobile.
model ContentPage {
  slug        String   @id
  title       String
  body        String
  published   Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("content_pages")
}
